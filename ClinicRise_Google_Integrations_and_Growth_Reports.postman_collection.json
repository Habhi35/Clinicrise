{
  "info": {
    "_postman_id": "7b8e1249-9c3f-4e12-8821-ab9123498124",
    "name": "ClinicRise - Google Integrations & Monthly Growth Reports API",
    "description": "Comprehensive, flow-wise Postman collection for ClinicRise Google Business Profile (GBP) API Management, Google Search Console, HIPAA-compliant AI Review Replies, Local 3-Pack Rank Tracking, and Monthly Growth Reports with Vector PDF Generation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "YOUR_JWT_ACCESS_TOKEN",
      "type": "string"
    },
    {
      "key": "practice_id",
      "value": "7a829f0e-3b52-47df-bc62-09419b48c712",
      "type": "string"
    },
    {
      "key": "review_id",
      "value": "b3810419-5d29-4114-88a2-219488a09841",
      "type": "string"
    },
    {
      "key": "keyword_id",
      "value": "1b6756fe-cfd3-40ac-8d03-ba8ba8c0224c",
      "type": "string"
    },
    {
      "key": "report_id",
      "value": "9938217a-89bc-4ef0-9123-abcd48194812",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Authentication & Setup",
      "description": "Initial login to retrieve JWT access token and user practice memberships.",
      "item": [
        {
          "name": "0.1 User Login (Obtain JWT & Practice ID)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dr.sharma@apollodental.com\",\n  \"password\": \"StrongPassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", ""]
            },
            "description": "Authenticates user and returns JWT access and refresh tokens. Copy access token into collection variable `jwt_token` and practice ID into `practice_id`."
          }
        }
      ]
    },
    {
      "name": "Stage 1: GBP Checklist & Local SEO Setup",
      "description": "Evaluate 10-point profile readiness, generate copy-pasteable SEO assets, and retrieve direct review links.",
      "item": [
        {
          "name": "1.1 Get GBP Checklist & Progress Score",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/checklist/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "checklist", ""]
            },
            "description": "Fetches dynamic 10-item checklist evaluation, overall completion percentage, badge color, and missing local SEO items."
          }
        },
        {
          "name": "1.2 Get Local SEO Setup Information",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/setup-info/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "setup-info", ""]
            },
            "description": "Generates copy-pasteable assets: formatted NAP, 750-character SEO business description, structured operating hours, category recommendations, and services menu."
          }
        },
        {
          "name": "1.3 Update GBP Configuration & Place ID",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"google_maps_place_id\": \"ChIJ_apollo_hyd_123\",\n  \"google_maps_url\": \"https://maps.google.com/?cid=109283471092\",\n  \"google_review_link\": \"https://g.page/r/apollo-dental-review\",\n  \"verification_status\": \"verified\",\n  \"primary_category\": \"Dental Clinic\",\n  \"secondary_categories\": [\"Orthodontist\", \"Dental Implants Periodontist\"],\n  \"has_wheelchair_accessible_entrance\": true,\n  \"accepts_upi_payments\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/checklist/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "checklist", ""]
            },
            "description": "Saves Google Maps Place ID, public listing URL, verification state, categories, and clinic accessibility attributes."
          }
        },
        {
          "name": "1.4 Toggle Manual Checklist Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item_key\": \"clinic_photos\",\n  \"is_completed\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/checklist/toggle/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "checklist", "toggle", ""]
            },
            "description": "Toggles manual checklist tasks (such as uploading clinic interior/exterior photos or signage) and recalculates progress percentage."
          }
        },
        {
          "name": "1.5 Get Review Shortcut & WhatsApp Templates",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/review-link/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "review-link", ""]
            },
            "description": "Retrieves the 1-click write-review shortcut link along with personalized WhatsApp and SMS message templates to request reviews after consultations."
          }
        }
      ]
    },
    {
      "name": "Stage 2: Google Account Connection & Synchronization",
      "description": "Configure Google Cloud OAuth credentials and trigger automated ingestion of 30-day GBP insights, patient reviews, and GSC data.",
      "item": [
        {
          "name": "2.1 Check GBP Connection State",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/connection/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "connection", ""]
            },
            "description": "Checks whether the clinic has connected their Google Business Profile account and shows the last sync timestamp."
          }
        },
        {
          "name": "2.2 Save Google OAuth & Location Credentials",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"google_account_email\": \"clinic.admin@apollodental.com\",\n  \"account_id\": \"accounts/1098234710\",\n  \"location_id\": \"locations/8821947291\",\n  \"is_connected\": true,\n  \"sync_status\": \"success\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/connection/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "connection", ""]
            },
            "description": "Updates the practice's Google Cloud OAuth credentials, account ID, and location resource ID."
          }
        },
        {
          "name": "2.3 Trigger Full GBP & Search Console Sync",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"force_refresh\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/sync/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "sync", ""]
            },
            "description": "Triggers on-demand synchronization: pulls 30 days of daily GBP insights, imports patient Google reviews, and pulls top GSC search queries."
          }
        },
        {
          "name": "2.4 Get 30-Day Performance Insights",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/insights/?days=30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "insights", ""],
              "query": [
                { "key": "days", "value": "30" }
              ]
            },
            "description": "Returns aggregated discovery metrics (Maps views, Search views, calls, directions, website clicks) and daily trend items."
          }
        }
      ]
    },
    {
      "name": "Stage 3: Patient Reviews & HIPAA-Compliant AI Replies",
      "description": "List patient reviews, generate tone-tailored HIPAA-compliant AI response drafts, and submit official replies.",
      "item": [
        {
          "name": "3.1 List Google Reviews (Filter Unreplied)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/reviews/?is_replied=false&rating=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "reviews", ""],
              "query": [
                { "key": "is_replied", "value": "false" },
                { "key": "rating", "value": "5" }
              ]
            },
            "description": "Lists patient reviews. Copy the review `id` from the response into collection variable `review_id`."
          }
        },
        {
          "name": "3.2 Generate HIPAA-Compliant AI Reply Draft",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tone\": \"empathetic_professional\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/reviews/{{review_id}}/generate-reply/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "reviews", "{{review_id}}", "generate-reply", ""]
            },
            "description": "Synthesizes an empathetic, tone-tailored draft response that strictly safeguards patient privacy by not disclosing diagnoses, prescriptions, or medical history."
          }
        },
        {
          "name": "3.3 Submit Official Reply to Google Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reply_text\": \"Thank you Pooja for your gracious review! We are dedicated to delivering compassionate, evidence-based clinical care. Warm regards from Team Apollo Dental Care.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/reviews/{{review_id}}/reply/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "reviews", "{{review_id}}", "reply", ""]
            },
            "description": "Posts the final response to the patient's Google review, updating `is_replied` to true and recording `replied_at`."
          }
        }
      ]
    },
    {
      "name": "Stage 4: Google Updates & Promotional Posts",
      "description": "Publish clinic announcements, health tips, OPD camps, and promotional packages with Call-to-Action buttons.",
      "item": [
        {
          "name": "4.1 Publish Google Post with Call-to-Action",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"post_type\": \"offer\",\n  \"summary\": \"October Dental Checkup Camp: Avail free digital panoramic X-ray with OPD consultation.\",\n  \"cta_type\": \"book\",\n  \"cta_url\": \"https://apollodental.clinicrise.com#appointment\",\n  \"image_url\": \"https://images.clinicrise.com/camps/october_checkup.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/posts/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "posts", ""]
            },
            "description": "Publishes a new Google update or special promotion. CTA types: `book`, `call`, `learn_more`, `order`."
          }
        },
        {
          "name": "4.2 List Published Google Posts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/posts/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "posts", ""]
            },
            "description": "Lists all active and historical Google posts published by the clinic team."
          }
        }
      ]
    },
    {
      "name": "Stage 5: Google Search Console (Organic Search Analytics)",
      "description": "Monitor organic patient discovery queries, clicks, impressions, click-through rates, and average Google ranking.",
      "item": [
        {
          "name": "5.1 Get Search Console Overview Dashboard",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/search-console/overview/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "search-console", "overview", ""]
            },
            "description": "Returns high-level organic search performance: total clicks, impressions, average CTR percentage, average position, and top 5 queries."
          }
        },
        {
          "name": "5.2 List Ranked Medical Search Queries",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/search-console/queries/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "search-console", "queries", ""]
            },
            "description": "Returns the complete table of medical search keywords entered by patients (e.g. 'dentist near me', 'root canal cost')."
          }
        }
      ]
    },
    {
      "name": "Stage 6: Local 3-Pack Rank Tracking (Google Maps Grid)",
      "description": "Track specialty keywords on Google Maps, run simulated geo-grid checks, inspect competitors, and measure 3-Pack dominance.",
      "item": [
        {
          "name": "6.1 List Tracked Keywords",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/rank-tracking/keywords/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "rank-tracking", "keywords", ""]
            },
            "description": "Lists all tracked local keywords. If none exist, automatically seeds 5 standard keywords based on the clinic's specialty and city."
          }
        },
        {
          "name": "6.2 Add New Tracked Keyword",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"keyword\": \"painless dental implants Hyderabad\",\n  \"target_city\": \"Hyderabad\",\n  \"target_radius_km\": 10\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/rank-tracking/keywords/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "rank-tracking", "keywords", ""]
            },
            "description": "Registers a new specialty keyword for local Google 3-Pack rank monitoring."
          }
        },
        {
          "name": "6.3 Run On-Demand Local Rank Check",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grid_density\": \"3x3\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/rank-tracking/check/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "rank-tracking", "check", ""]
            },
            "description": "Executes on-demand Google Maps grid simulation, evaluates 3-Pack presence (#1 to #3 vs. outside pack), and records competitor rankings."
          }
        },
        {
          "name": "6.4 Get Local 3-Pack Overview & Dominance",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/rank-tracking/overview/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "rank-tracking", "overview", ""]
            },
            "description": "Calculates local pack dominance percentage (`keywords_in_three_pack / total_keywords * 100`), keywords in top 3, and average pack rank."
          }
        },
        {
          "name": "6.5 Untrack / Delete Keyword",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gbp/rank-tracking/keywords/{{keyword_id}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gbp", "rank-tracking", "keywords", "{{keyword_id}}", ""]
            },
            "description": "Soft-deletes or deactivates a tracked keyword."
          }
        }
      ]
    },
    {
      "name": "Stage 7: Monthly Growth Reports & Vector PDF Generation",
      "description": "Synthesize cross-module performance metrics (patient acquisition, GBP discovery, GSC queries, pack rank), review executive summaries, and download publication-ready vector PDFs.",
      "item": [
        {
          "name": "7.1 List Practice Monthly Growth Reports",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/reports/monthly/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "monthly", ""]
            },
            "description": "Lists historical monthly performance reports. If none exist, automatically synthesizes the current month's report. Copy report `id` into collection variable `report_id`."
          }
        },
        {
          "name": "7.2 Generate Custom Month Growth Report",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Practice-ID", "value": "{{practice_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"year\": 2026,\n  \"month\": 9\n}",
              "options": { "raw": { "language": "json" } }
            },
